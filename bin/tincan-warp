#!/usr/bin/env python3
"""Open a real Codex + Claude Code pair using a Warp Tab Config."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import secrets
import shutil
import shlex
import subprocess
import sys
import tempfile


CONFIG_STEM = "tincan_pair"
POOLSIDE_CONFIG_STEM = "tincan_poolside"


def fail(message: str) -> "NoReturn":
    print(f"tincan: {message}", file=sys.stderr)
    raise SystemExit(2)


def repo_root(candidate: str) -> Path:
    path = Path(candidate).expanduser().resolve()
    if not path.is_dir():
        fail(f"repository path does not exist: {path}")

    result = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        fail(f"not inside a Git repository: {path}")
    return Path(result.stdout.strip()).resolve()


def toml_string(value: str) -> str:
    # JSON strings use the same quoting and escapes needed here by TOML.
    return json.dumps(value)


def git_dir(repo: Path) -> Path:
    result = subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "--path-format=absolute", "--git-dir"],
        text=True,
        capture_output=True,
    )
    if result.returncode:
        fail(f"could not locate Git metadata for {repo}")
    return Path(result.stdout.strip()).resolve()


def ensure_hook(repo: Path) -> None:
    control = Path(__file__).resolve().with_name("tincan-control")
    result = subprocess.run([str(control), "install", "--repo", str(repo)])
    if result.returncode:
        fail("could not install the Codex handoff hook; see the message above")


def _poolside_claude_settings_path(sessions: Path, token: str) -> Path:
    """Path for Claude settings that routes reviews to poolside (not codex)."""
    return sessions / f"{token}-poolside-claude-settings.json"


def create_session(repo: Path, token: str, max_rounds: int, mode: str,
                   poolside: bool = False,
                   no_codex: bool = False, no_claude: bool = False) -> Path:
    state_dir = git_dir(repo) / "tincan"
    sessions = state_dir / "pane-sessions"
    sessions.mkdir(parents=True, exist_ok=True)
    if poolside:
        hook_name = "tincan-pool-claude-hook"
    else:
        hook_name = (
            "tincan-brainstorm-hook" if mode == "brainstorm" else "tincan-claude-hook"
        )
        review_hook_name = "tincan-review-hook"
    claude_hook = Path(__file__).resolve().with_name(hook_name)
    settings_path = sessions / f"{token}-claude-settings.json"

    if not poolside:
        settings = {
            "hooks": {
                "Stop": [
                    {
                        "hooks": [
                            {
                                "type": "command",
                                "command": str(claude_hook),
                                "timeout": 30,
                                "statusMessage": (
                                    "Coordinating the brainstorm"
                                    if mode == "brainstorm"
                                    else "Sending Claude's review to Codex"
                                ),
                            }
                        ]
                    }
                ]
            }
        }
        settings_path.write_text(json.dumps(settings, indent=2, sort_keys=True) + "\n")
    else:
        # In poolside mode, Claude's Stop hook sends the verdict to the
        # Poolside pane instead of back to the Codex pane.
        settings = {
            "hooks": {
                "Stop": [
                    {
                        "hooks": [
                            {
                                "type": "command",
                                "command": str(claude_hook),
                                "timeout": 30,
                                "statusMessage": "Sending Claude's review to Poolside",
                            }
                        ]
                    }
                ]
            }
        }
        settings_path.write_text(json.dumps(settings, indent=2, sort_keys=True) + "\n")

    value = {
        "enabled": True,
        "mode": mode,
        "poolside_mode": poolside,
        "no_codex": no_codex,
        "no_claude": no_claude,
        "repo": str(repo),
        "session_token": token,
        "status": "awaiting-user" if mode == "brainstorm" else "awaiting-codex",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "handoffs": 0,
        "round": 0,
        "cycle": 0 if mode == "brainstorm" else 1,
        "max_rounds": max_rounds,
        "claude_settings": str(settings_path),
    }
    if poolside:
        value["status"] = "awaiting-user"
        value["review_chain"] = (
            ["poolside", "claude", "poolside"] if no_codex
            else (["poolside", "codex", "poolside"] if no_claude
                  else ["poolside", "codex", "claude", "poolside"])
        )
    session_path = sessions / f"{token}.json"
    session_path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    active = state_dir / "active-pane-session.json"
    temporary = active.with_suffix(".tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    temporary.replace(active)
    return session_path


def render_config(repo: Path, session: str, mode: str = "visible-review-loop",
                  poolside: bool = False, no_codex: bool = False,
                  no_claude: bool = False) -> str:
    repo_text = str(repo)
    tincan = Path(__file__).resolve().with_name("tincan")
    codex_command = " ".join(
        shlex.quote(part)
        for part in (str(tincan), "codex-pane", "--repo", repo_text, "--session", session)
    )
    claude_command = " ".join(
        shlex.quote(part)
        for part in (str(tincan), "claude-pane", "--repo", repo_text, "--session", session)
    )
    poolside_command = " ".join(
        shlex.quote(part)
        for part in (str(tincan), "poolside-pane", "--repo", repo_text, "--session", session)
    )
    if poolside and not no_claude and not no_codex:
        # Full 3-pane: Poolside + Codex (top) + Claude (bottom)
        label = "Tincan Poolside"
        return f'''name = {toml_string(label)}
title = {toml_string(f"{label} · {repo.name}")}
color = "cyan"

[[panes]]
id = "root"
split = "vertical"
children = ["top", "claude"]

[[panes]]
id = "top"
split = "horizontal"
children = ["poolside", "codex"]

[[panes]]
id = "poolside"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(poolside_command)}]
is_focused = true

[[panes]]
id = "codex"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(codex_command)}]

[[panes]]
id = "claude"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(claude_command)}]
'''
    if poolside and no_claude:
        # 2-pane: Poolside (top) + Codex (bottom). Review goes Codex → Poolside.
        label = "Tincan Poolside (Codex review)"
        return f'''name = {toml_string(label)}
title = {toml_string(f"{label} · {repo.name}")}
color = "cyan"

[[panes]]
id = "root"
split = "vertical"
children = ["poolside", "codex"]

[[panes]]
id = "poolside"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(poolside_command)}]
is_focused = true

[[panes]]
id = "codex"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(codex_command)}]
'''
    if poolside and no_codex:
        # 2-pane: Poolside (top) + Claude (bottom). Review goes Claude → Poolside.
        label = "Tincan Poolside (Claude review)"
        return f'''name = {toml_string(label)}
title = {toml_string(f"{label} · {repo.name}")}
color = "cyan"

[[panes]]
id = "root"
split = "vertical"
children = ["poolside", "claude"]

[[panes]]
id = "poolside"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(poolside_command)}]
is_focused = true

[[panes]]
id = "claude"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(claude_command)}]
'''
    label = "Tincan Brainstorm" if mode == "brainstorm" else "Tincan Pair"
    return f'''name = {toml_string(label)}
title = {toml_string(f"{label} · {repo.name}")}
color = "cyan"

[[panes]]
id = "root"
split = "horizontal"
children = ["codex", "claude"]

[[panes]]
id = "codex"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(codex_command)}]
is_focused = true

[[panes]]
id = "claude"
type = "terminal"
directory = {toml_string(repo_text)}
commands = [{toml_string(claude_command)}]
'''


def write_config(
    repo: Path, session: str, mode: str = "visible-review-loop", poolside: bool = False,
    no_codex: bool = False, no_claude: bool = False,
) -> Path:
    config_dir = Path(
        os.environ.get("TINCAN_WARP_CONFIG_DIR", "~/.warp/tab_configs")
    ).expanduser()
    if poolside:
        stem = POOLSIDE_CONFIG_STEM
    else:
        stem = CONFIG_STEM
    config_dir.mkdir(parents=True, exist_ok=True)
    destination = config_dir / f"{stem}.toml"

    handle, temporary_name = tempfile.mkstemp(
        prefix=f".{stem}.", suffix=".toml", dir=config_dir
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(render_config(repo, session, mode, poolside=poolside,
                                   no_codex=no_codex, no_claude=no_claude))
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)
    return destination


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Open real Codex and Claude Code TUIs side by side in Warp."
    )
    parser.add_argument(
        "--repo",
        default=".",
        help="Git repository to open (default: current repository)",
    )
    parser.add_argument(
        "--tab",
        action="store_true",
        help="open a tab in the current Warp window instead of a new window",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="write the config but do not launch Warp",
    )
    parser.add_argument(
        "--max-rounds",
        type=int,
        choices=range(1, 11),
        default=5,
        help="maximum Claude review rounds before asking a human (default: 5)",
    )
    parser.add_argument(
        "--brainstorm",
        action="store_true",
        help="run an independent-first Codex and Claude brainstorm",
    )
    parser.add_argument(
        "--poolside",
        action="store_true",
        help="run Poolside as implementation with Codex and Claude as reviewers "
        "(3-pane layout)",
    )
    parser.add_argument(
        "--no-codex",
        action="store_true",
        help="exclude Codex from the poolside review chain "
        "(requires --poolside; 2-pane: Poolside + Claude)",
    )
    parser.add_argument(
        "--no-claude",
        action="store_true",
        help="exclude Claude from the poolside review chain "
        "(requires --poolside; 2-pane: Poolside + Codex)",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    repo = repo_root(args.repo)

    missing = [command for command in ("codex", "claude") if not shutil.which(command)]
    if missing and not args.dry_run:
        fail(f"missing from PATH: {', '.join(missing)}")
    if args.poolside and not shutil.which("pool") and not args.dry_run:
        fail("pool is not on PATH; install the Poolside CLI to use --poolside mode")
    if args.poolside and args.no_codex and args.no_claude:
        fail("--no-codex and --no-claude are mutually exclusive; at least one reviewer is required")

    session = secrets.token_hex(16)
    mode = "brainstorm" if args.brainstorm else "visible-review-loop"
    config_stem = POOLSIDE_CONFIG_STEM if args.poolside else CONFIG_STEM
    if not args.dry_run:
        ensure_hook(repo)
        create_session(
            repo, session, args.max_rounds, mode,
            poolside=args.poolside,
            no_codex=getattr(args, "no_codex", False),
            no_claude=getattr(args, "no_claude", False),
        )
    destination = write_config(
        repo, session, mode,
        poolside=args.poolside,
        no_codex=getattr(args, "no_codex", False),
        no_claude=getattr(args, "no_claude", False),
    )
    uri = f"warp://tab_config/{config_stem}"
    if not args.tab:
        uri += "?new_window=true"

    if args.dry_run:
        print(f"wrote {destination}")
        print(f"would create paired session {session}")
        print(f"would open {uri}")
        return 0

    try:
        subprocess.run(["open", uri], check=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        fail("could not open Warp; is Warp installed and registered for warp:// links?")

    print(f"opened Tincan for {repo} (session {session[:8]})")
    if args.brainstorm:
        print("Ready. Ask in Codex; Tincan will gather both independent views.")
    elif args.poolside:
        if args.no_claude:
            print("Ready. Give Poolside a task; send reviews with 'tincan send-codex'.")
        elif args.no_codex:
            print("Ready. Give Poolside a task; send reviews with 'tincan send-claude'.")
        else:
            print("Ready. Give Poolside a task; send reviews with 'tincan send-codex'.")
    else:
        print("Ready. Give Codex a normal task.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
