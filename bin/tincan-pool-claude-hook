#!/usr/bin/env python3
"""Claude Stop adapter for the visible Poolside review controller."""
import json
import os
from pathlib import Path
import sys
from tincan_pool_loop import handle, helpers


def main():
    try:
        event = json.load(sys.stdin)
    except (ValueError, OSError):
        return 0
    paths = helpers.git_paths(Path(event.get("cwd") or os.getcwd()))
    result = handle(*paths, event, os.environ.get("TINCAN_SESSION", ""), "claude") if paths else {}
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
