#!/usr/bin/env python3
"""Claude Stop hook for the Poolside review loop.

In poolside-visible mode the review chain is:
  Poolside (writer) → Codex (peer reviewer) → Claude (secondary reviewer)
  → back to Poolside.

This hook is installed in Claude's settings instead of tincan-claude-hook.
It behaves identically except the final verdict is routed to the **Poolside**
pane (``--agent poolside``) rather than back to the Codex pane.
"""

from __future__ import annotations

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any


def emit(value: dict[str, Any]) -> None:
    print(json.dumps(value, separators=(",", ":")))


def load_json(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_json(path: Path, value: dict[str, Any]) -> None:
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    temporary.replace(path)


def git_paths(cwd: Path) -> tuple[Path, Path] | None:
    root_result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        cwd=cwd,
        text=True,
        capture_output=True,
    )
    if root_result.returncode:
        return None
    root = Path(root_result.stdout.strip())
    git_result = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-dir"],
        cwd=root,
        text=True,
        capture_output=True,
    )
    if git_result.returncode:
        return None
    return root, Path(git_result.stdout.strip())


def parse_verdict(message: str) -> str | None:
    matches = re.findall(
        r"(?im)^\s*TINCAN_VERDICT:\s*(APPROVED|CHANGES_REQUESTED)\s*$", message
    )
    return matches[-1].upper() if matches else None


def poolside_prompt(
    event: dict[str, Any],
    round_number: int,
    verdict: str | None,
    at_limit: bool,
    triage_followups: bool,
) -> str:
    """Build the prompt delivered to the Poolside pane after Claude's review."""
    review = event.get("last_assistant_message") or "(Claude supplied no final review text.)"
    if verdict == "APPROVED" and triage_followups:
        instruction = (
            "Claude found no blocking issues but noted optional suggestions.  Consider "
            "implementing one that is clearly in scope, small, low-risk, and verifiable; "
            "defer the rest.  Summarize your decisions for the user."
        )
    elif verdict == "APPROVED":
        instruction = (
            "Claude found no blocking issues.  Briefly summarize the final result and "
            "any deferred suggestions for the user."
        )
    elif at_limit:
        instruction = (
            "The review loop has reached its round limit.  Summarize the unresolved "
            "points and ask the user to adjudicate."
        )
    elif verdict == "CHANGES_REQUESTED":
        instruction = (
            "Consider every blocking finding.  Fix it when valid, or push back with "
            "concrete evidence.  Suggestions are optional.  Verify your work and state "
            "how you handled each blocker."
        )
    else:
        instruction = (
            "Claude did not provide the required verdict marker.  Summarize the review "
            "and ask the user whether to proceed."
        )
    return f"""Claude secondary review, round {round_number}:

{review}

{instruction}"""


def main() -> int:
    try:
        event = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        emit({})
        return 0

    token = os.environ.get("TINCAN_SESSION", "")
    if not re.fullmatch(r"[0-9a-f]{32}", token):
        emit({})
        return 0
    paths = git_paths(Path(event.get("cwd") or os.getcwd()))
    if not paths:
        emit({})
        return 0
    root, git_dir = paths
    session_path = git_dir / "tincan" / "pane-sessions" / f"{token}.json"
    session = load_json(session_path)
    if (
        not session.get("enabled")
        or session.get("session_token") != token
        or session.get("repo") != str(root)
        or session.get("status") != "awaiting-claude"
    ):
        emit({})
        return 0

    message = event.get("last_assistant_message") or ""
    verdict = parse_verdict(message)
    round_number = int(session.get("round", 1))
    max_rounds = int(session.get("max_rounds", 5))
    at_limit = verdict == "CHANGES_REQUESTED" and round_number >= max_rounds
    triage_followups = (
        verdict == "APPROVED"
        and bool(session.get("review_content_fingerprint"))
        and session.get("review_kind", "task") != "followup"
        and round_number < max_rounds
    )

    if verdict == "CHANGES_REQUESTED" and not at_limit:
        next_status = "awaiting-user"
        enabled = True
    elif verdict == "APPROVED":
        next_status = "awaiting-user"
        enabled = True
        if session.get("review_content_fingerprint"):
            session["approved_content_fingerprint"] = session[
                "review_content_fingerprint"
            ]
    else:
        next_status = "needs-human"
        enabled = False

    session.update(
        enabled=enabled,
        status=next_status,
        claude_session_id=event.get("session_id"),
        last_verdict=verdict or "missing",
    )
    save_json(session_path, session)

    pane = os.environ.get(
        "TINCAN_PANE", str(Path(__file__).resolve().with_name("tincan-pane"))
    )
    # In poolside mode the verdict goes to the Poolside pane, not Codex.
    target_agent = "poolside" if session.get("poolside_mode") else "codex"
    result = subprocess.run(
        [
            pane,
            "send",
            "--agent",
            target_agent,
            "--repo",
            str(root),
            "--session",
            token,
            "--wait",
            "5",
        ],
        input=poolside_prompt(
            event, round_number, verdict, at_limit, triage_followups
        ),
        text=True,
        capture_output=True,
    )
    if result.returncode:
        detail = (result.stderr or result.stdout).strip()
        session.update(status="claude-return-failed", error=detail)
        save_json(session_path, session)
        target_label = "Poolside" if target_agent == "poolside" else "Codex"
        emit({"systemMessage": f"Tincan could not return this review to {target_label}: {detail}"})
        return 0

    session.update(
        enabled=enabled,
        status=next_status,
        handoffs=int(session.get("handoffs", 0)) + 1,
        last_handoff_at=datetime.now(timezone.utc).isoformat(),
    )
    save_json(session_path, session)
    target_label = "Poolside" if target_agent == "poolside" else "Codex"
    if next_status == "awaiting-codex-summary":
        detail = f"Claude approved review round {round_number}; {target_label} is finalizing."
    elif next_status == "awaiting-user":
        detail = f"Claude requested changes in round {round_number}; Tincan returned them to {target_label}."
    else:
        detail = "Tincan stopped the loop for human adjudication."
    emit({"systemMessage": detail})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
